{
    "id": "ws-voice-filters",
    "version": "1",
    "name": "Voice filters",
    "category": "Processing",
    "icon": "sliders",
    "side": "backend",
    "customizable": true,
    "summary": "Voice effects on audio files: 43 presets in 5 groups (broadcast, devices, spaces, characters & sci-fi, creative) plus EQ, pitch, speed, reverb, echo, distortion, phaser, tremolo, hiss, crackle and fad",
    "help": "Wire WAV files in. Pick a preset and add your own settings on top (pitch and gain add to the preset; the others replace its value). Order: trim → speed → pitch → high/low-pass → ring mod → tremolo → distortion → bit crush → chorus → phaser → echo → reverb → compressor → gain → hiss/crackle → normalize → fades. 'Compare presets' renders each take through several presets at once. Presets — Clean & broadcast: None, Studio voice, Podcast, Broadcast announcer, Warm narrator, Whisper-soft · Devices: Telephone, Mobile call, AM radio, Old radio (1940s), Vinyl record, Walkie-talkie, Intercom, Drive-thru speaker, Megaphone, Stadium PA, Space helmet · Spaces: Small room, Bathroom, Concert hall, Cathedral, Cave, Canyon echo, Distant voice, Next room, Underwater · Characters & sci-fi: Deep voice, Giant, Demon, Robot, Cyborg, Alien, Ghost, Chipmunk, Helium, Sci-fi computer · Creative & lo-fi: Lo-fi, 8-bit arcade, Dreamy, Slow motion, Fast forward, Tremolo, Phaser sweep.",
    "inputs": [
        {
            "id": "audio",
            "label": "Audio (WAV)",
            "type": "files",
            "many": true,
            "formats": [
                "wav",
                "flac",
                "ogg"
            ]
        }
    ],
    "outputs": [
        {
            "id": "filtered",
            "label": "Filtered (WAV)",
            "type": "files",
            "formats": [
                "wav"
            ]
        },
        {
            "id": "mp3",
            "label": "MP3 copies",
            "type": "files",
            "formats": [
                "mp3"
            ]
        },
        {
            "id": "table",
            "label": "Filter chain",
            "type": "table",
            "formats": [
                "csv"
            ]
        }
    ],
    "params": [
        {
            "key": "preset",
            "label": "Preset",
            "type": "select",
            "default": "Studio voice",
            "options": [
                "None",
                "Studio voice",
                "Podcast",
                "Broadcast announcer",
                "Warm narrator",
                "Whisper-soft",
                "Telephone",
                "Mobile call",
                "AM radio",
                "Old radio (1940s)",
                "Vinyl record",
                "Walkie-talkie",
                "Intercom",
                "Drive-thru speaker",
                "Megaphone",
                "Stadium PA",
                "Space helmet",
                "Small room",
                "Bathroom",
                "Concert hall",
                "Cathedral",
                "Cave",
                "Canyon echo",
                "Distant voice",
                "Next room",
                "Underwater",
                "Deep voice",
                "Giant",
                "Demon",
                "Robot",
                "Cyborg",
                "Alien",
                "Ghost",
                "Chipmunk",
                "Helium",
                "Sci-fi computer",
                "Lo-fi",
                "8-bit arcade",
                "Dreamy",
                "Slow motion",
                "Fast forward",
                "Tremolo",
                "Phaser sweep"
            ]
        },
        {
            "key": "compare",
            "label": "Compare presets (comma-separated, optional)",
            "type": "text",
            "default": "",
            "help": "e.g. Telephone, Robot, Cathedral: each take is rendered with each of them (your settings below are added to each)."
        },
        {
            "key": "gain_db",
            "label": "Gain (dB)",
            "type": "number",
            "default": 0,
            "min": -30,
            "max": 30
        },
        {
            "key": "highpass_hz",
            "label": "High-pass (Hz, 0 = off)",
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 8000
        },
        {
            "key": "lowpass_hz",
            "label": "Low-pass (Hz, 0 = off)",
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 22000
        },
        {
            "key": "pitch",
            "label": "Pitch (semitones)",
            "type": "number",
            "default": 0,
            "min": -12,
            "max": 12
        },
        {
            "key": "speed",
            "label": "Speed (keeps the pitch)",
            "type": "number",
            "default": 1,
            "min": 0.5,
            "max": 2
        },
        {
            "key": "reverb",
            "label": "Reverb (0-1)",
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 1
        },
        {
            "key": "echo_ms",
            "label": "Echo delay (ms, 0 = off)",
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 2000
        },
        {
            "key": "echo_feedback",
            "label": "Echo feedback (0-0.9)",
            "type": "number",
            "default": 0.3,
            "min": 0,
            "max": 0.9
        },
        {
            "key": "distortion_db",
            "label": "Distortion drive (dB, 0 = off)",
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 40
        },
        {
            "key": "robot_hz",
            "label": "Robot ring modulation (Hz, 0 = off)",
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 500
        },
        {
            "key": "tremolo_hz",
            "label": "Tremolo (Hz, 0 = off)",
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 40
        },
        {
            "key": "noise_db",
            "label": "Tape hiss (dB below the voice, 0 = off)",
            "type": "number",
            "default": 0,
            "min": -80,
            "max": 0,
            "help": "e.g. -40"
        },
        {
            "key": "chorus",
            "label": "Chorus",
            "type": "bool",
            "default": false
        },
        {
            "key": "phaser",
            "label": "Phaser",
            "type": "bool",
            "default": false
        },
        {
            "key": "crackle",
            "label": "Vinyl crackle",
            "type": "bool",
            "default": false
        },
        {
            "key": "compress",
            "label": "Compressor",
            "type": "bool",
            "default": false
        },
        {
            "key": "trim",
            "label": "Trim leading/trailing silence",
            "type": "bool",
            "default": true
        },
        {
            "key": "normalize",
            "label": "Normalize to -1 dBFS",
            "type": "bool",
            "default": true
        },
        {
            "key": "fade_in_ms",
            "label": "Fade in (ms)",
            "type": "number",
            "default": 10,
            "min": 0,
            "max": 5000
        },
        {
            "key": "fade_out_ms",
            "label": "Fade out (ms)",
            "type": "number",
            "default": 50,
            "min": 0,
            "max": 5000
        }
    ],
    "hardware": [
        "cpu"
    ],
    "packages": [
        "pedalboard>=0.9",
        "soundfile>=0.12",
        "numpy",
        "scipy"
    ],
    "esasim": {
        "version": 4
    }
}
